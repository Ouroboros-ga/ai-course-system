# ===========================================
# 超星AI互动智课系统 - 环境变量配置示例
# ===========================================
#
# 📖 使用方法：
#    1. 复制此文件：cp .env.example .env
#    2. 编辑 .env 文件，填入实际配置值
#    3. 确保敏感信息不提交到版本控制（.gitignore已忽略.env）
#
# ⚠️  安全提示：
#    - 不要将包含真实密钥的 .env 文件提交到Git
#    - 生产环境请使用强密码和随机生成的密钥
#    - 定期轮换API密钥和JWT密钥
#
# 🔗 功能模块对应关系：
#    F1: 素材管理        F2/F5: 映射引擎      F3: PPT生成
#    F4: 脚本编辑/TTS    F6: 分屏播放器       F7: 平台对接
#
# ===========================================

# ============================================================
# 第零部分：数据库与环境隔离配置
# ============================================================
#
# 本系统默认使用本地 SQLite 文件存储。生产、Staging、测试三套数据
# 必须彻底隔离，严禁复用同一份数据库文件。
#
# --------------------------
# 数据库 URL（核心开关）
# --------------------------
# 不设置时默认使用 <repo>/database/smart_class.db
# Staging 环境：指向独立的 staging 数据库文件，例如：
#   AI_COURSE_DATABASE_URL=sqlite:///./database/staging.db
# 生产环境：使用专用迁移器与独立数据库，不要与开发库混用。
# AI_COURSE_DATABASE_URL=sqlite:///./database/smart_class.db

# --------------------------
# 启动副作用开关
# --------------------------
# 设为 1 时跳过依赖检查、建表、迁移（测试与 CI 使用）
# AI_COURSE_SKIP_STARTUP_SIDE_EFFECTS=0

# --------------------------
# 测试模式标记（信息性，由 conftest 自动设置）
# --------------------------
# AI_COURSE_TESTING=0


# ============================================================
# 第一部分：核心安全配置（必须修改！）
# ============================================================

# --------------------------
# 签名校验配置（泛雅平台对接 - F7）
# --------------------------
STATIC_KEY=your-static-key-here
SIGN_TIMEOUT_MINUTES=5
SIGN_ALGORITHM=MD5
TIME_FORMAT=%Y-%m-%d %H:%M:%S

# --------------------------
# JWT身份认证配置
# --------------------------
# ⚠️ 生产环境必须使用长随机字符串（至少32位）
JWT_SECRET_KEY=your-jwt-secret-key-very-long-random-string
# Dedicated Fernet material for encrypted administrator-managed Provider keys.
# Generate and keep it deployment-side; never put a real value in this file.
PLATFORM_CONFIG_ENCRYPTION_KEY=replace-with-a-dedicated-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120


# ============================================================
# 第二部分：大模型API配置（LLM - 脚本生成核心）
# ============================================================

# --------------------------
# LLM提供商选择
# --------------------------
# 可选值：doubao（豆包/火山引擎）、qwen（通义千问/阿里云）、openai
LLM_PROVIDER=doubao

# --------------------------
# 通用LLM参数
# --------------------------
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=180

# Initial intelligent course preparation. These limits do not change the
# shared LLM defaults used by other agents.
COURSE_BUILD_STAGE_TIMEOUT_SECONDS=240
COURSE_BUILD_TOTAL_TIMEOUT_SECONDS=900
PREP_INITIAL_EVIDENCE_UNIT_TARGET_CHARS=1500
PREP_INITIAL_EVIDENCE_UNIT_MAX_CHARS=2400
PREP_INITIAL_EVIDENCE_TOTAL_MAX_CHARS=600000
PREP_INITIAL_EVIDENCE_MAX_UNITS=1000
PREP_INITIAL_EVIDENCE_MAP_TEXT_CHARS=24000
PREP_INITIAL_EVIDENCE_MAP_PAYLOAD_CHARS=36000
PREP_INITIAL_EVIDENCE_MAP_MAX_CHUNKS=25
PREP_INITIAL_EVIDENCE_CONCURRENCY=2
PREP_INITIAL_EVIDENCE_MAX_ATTEMPTS=40
PREP_INITIAL_EVIDENCE_MAP_MAX_TOKENS=4096
PREP_INITIAL_EVIDENCE_MAP_RETRY_MAX_TOKENS=8192
PREP_INITIAL_EVIDENCE_REDUCE_MAX_TOKENS=16384
PREP_INITIAL_OUTLINE_MAX_TOKENS=16384
PREP_INITIAL_SCRIPT_BATCH_SIZE=3
PREP_INITIAL_SCRIPT_MAX_TOKENS=4096
PREP_INITIAL_SCRIPT_SINGLE_MAX_TOKENS=12288
PREP_INITIAL_VERIFIER_MAX_TOKENS=4096
PREP_INITIAL_MAX_KNOWLEDGE_POINTS=24
PREP_INITIAL_MAX_OUTLINE_NODES=64

# OpenAI兼容接口配置（可选，用于自定义OpenAI兼容服务）
# LLM_API_KEY=your-openai-api-key
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-3.5-turbo

# --------------------------
# 豆包配置（火山引擎）【推荐】
# --------------------------
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_ENDPOINT_ID=your-doubao-endpoint-id

# --------------------------
# 通义千问配置（阿里云）
# --------------------------
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL_NAME=qwen-turbo


# ============================================================
# 第三部分：语音合成TTS配置（F4 - 数字人配音）
# ============================================================

# --------------------------
# TTS提供商选择
# --------------------------
# 可选值：aliyun（阿里云）、tencent（腾讯云）、volcengine（火山引擎）
TTS_PROVIDER=volcengine

# --------------------------
# 通用TTS参数
# --------------------------
TTS_SAMPLE_RATE=16000
TTS_FORMAT=mp3
# TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts

# 通用TTS凭证（可选，部分提供商使用）
# TTS_API_KEY=your-tts-api-key
# TTS_API_SECRET=your-tts-api-secret
# TTS_APP_ID=your-tts-app-id

# --------------------------
# 阿里云TTS配置
# --------------------------
# ALIYUN_TTS_ACCESS_KEY_ID=your-aliyun-access-key-id
# ALIYUN_TTS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
# ALIYUN_TTS_APP_KEY=your-aliyun-tts-app-key

# --------------------------
# 腾讯云TTS配置
# --------------------------
# TENCENT_TTS_SECRET_ID=your-tencent-secret-id
# TENCENT_TTS_SECRET_KEY=your-tencent-secret-key
# TENCENT_TTS_APP_ID=your-tencent-app-id

# --------------------------
# 火山引擎TTS配置【推荐】
# --------------------------
VOLCENGINE_TTS_APP_ID=your-volcengine-tts-app-id
VOLCENGINE_TTS_ACCESS_TOKEN=your-volcengine-tts-access-token
VOLCENGINE_TTS_SECRET_KEY=your-volcengine-tts-secret-key
# 可选音色：
#   zh_female_shuangkuaisisi_moon_bigtts （女声，推荐）
#   zh_male_chunhou_zhiboshuangkuai         （男声）
TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts

# --------------------------
# 火山引擎声音复刻配置（可选，高级功能）
# --------------------------
# 用于克隆特定声音进行TTS合成
# VOLCENGINE_VOICE_CLONE_API_KEY=your-x-api-key
# 模型类型：1=ICL1.0, 2=DiT标准, 3=DiT还原, 4=ICL2.0(默认)
# VOLCENGINE_VOICE_CLONE_MODEL_TYPE=4

# --------------------------
# 豆包语音合成大模型 2.0（v3 双向 WebSocket；由 Media Worker 消费）
# --------------------------
# 此组凭据仅供后端 Media Worker 使用；不要放入前端 .env、日志或测试 fixture。
# 启用正式 Provider 时，同时设置 STAGE8_TTS_PROVIDER=doubao。真实调用只会由
# Media Worker 发起；不要在前端 .env、日志或测试 fixture 中复制本组凭据。
# Local Demo must explicitly enable this flag. The UI will show fake-demo and
# no paid TTS provider is contacted.
MEDIA_DEMO_MODE=true
# Formal configuration: set MEDIA_DEMO_MODE=false and explicitly select the
# paid provider. Stage 8 never silently falls back to Fake.
# MEDIA_DEMO_MODE=false
# STAGE8_TTS_PROVIDER=doubao
# VOLCENGINE_DOUBAO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
# VOLCENGINE_DOUBAO_TTS_API_KEY=your-volcengine-api-key
# 预置音色使用 seed-tts-2.0；复刻音色使用 seed-icl-2.0，并填写音色库 speaker ID。
# VOLCENGINE_DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# VOLCENGINE_DOUBAO_TTS_SPEAKER=your-speaker-id
# VOLCENGINE_DOUBAO_TTS_FORMAT=mp3
# VOLCENGINE_DOUBAO_TTS_SAMPLE_RATE=24000
# 仅 seed-tts-2.0 明确支持字级时间戳；seed-icl-2.0 的字幕和音素返回须先经 POC 验证。
# VOLCENGINE_DOUBAO_TTS_ENABLE_SUBTITLE=true
# VOLCENGINE_DOUBAO_TTS_CONNECT_TIMEOUT_SECONDS=15
# VOLCENGINE_DOUBAO_TTS_READ_TIMEOUT_SECONDS=90


# ============================================================
# 第四部分：数字人视频生成配置（F5 - Gradio API）
# ============================================================

# --------------------------
# 数字人Gradio服务地址
# --------------------------
# 默认本地运行，如使用远程服务请修改为实际地址
DIGITAL_HUMAN_API_URL=http://localhost:7860/

# --------------------------
# 数字人生成参数
# --------------------------
# 分辨率缩小倍数（2=原比例缩小2倍，数值越大分辨率越低但速度越快）
DIGITAL_HUMAN_MIN_RESOLUTION=2
# 是否强制缩小分辨率（true/false）
DIGITAL_HUMAN_IF_RES=False
# 处理批次（越大越快但可能显存不足，建议4-8）
DIGITAL_HUMAN_STEPS=4


# ============================================================
# 第五部分：存储路径配置
# ============================================================

# --------------------------
# 视频文件存储路径（F5/F6）
# --------------------------
# VIDEO_STORAGE_PATH=./videos
# TEMP_VIDEO_STORAGE_PATH=./temp_videos
# MEDIA_STORAGE_PATH=./media

# Course knowledge bundle / GraphRAG / LanceDB
# GRAPHRAG is billable when configured with a paid completion/embedding API.
# Keep it disabled until both model endpoints have passed the explicit smoke.
KNOWLEDGE_BUNDLE_ENABLED=true
GRAPHRAG_ENABLED=false
GRAPHRAG_WORKER_PYTHON=
GRAPHRAG_STORAGE_ROOT=./media/knowledge_indexes
GRAPHRAG_COMPLETION_PROVIDER=
GRAPHRAG_COMPLETION_MODEL=
GRAPHRAG_COMPLETION_API_BASE=
GRAPHRAG_COMPLETION_API_KEY=
GRAPHRAG_EMBEDDING_PROVIDER=
GRAPHRAG_EMBEDDING_MODEL=
GRAPHRAG_EMBEDDING_API_BASE=
GRAPHRAG_EMBEDDING_API_KEY=
GRAPHRAG_EMBEDDING_DIMENSION=0
GRAPHRAG_EMBEDDING_BATCH_SIZE=64
GRAPHRAG_EMBEDDING_LOCAL_PATH=
GRAPHRAG_EMBEDDING_MAX_LENGTH=512
GRAPHRAG_EMBEDDING_QUERY_INSTRUCTION=
GRAPHRAG_PROMPT_POLICY=edu-graph-graphrag/2.0-zh
GRAPHRAG_MAX_GLEANINGS=1
GRAPHRAG_MAX_RETRIES=2
GRAPHRAG_RUN_TIMEOUT_SECONDS=1800
GRAPHRAG_MAX_INPUT_TOKENS=0
# USD preflight estimate only; configure provider-side quotas for a hard cap.
GRAPHRAG_ESTIMATED_INPUT_COST_USD_PER_MILLION_TOKENS=30
GRAPHRAG_MAX_ESTIMATED_COST_USD=0
# Deprecated compatibility alias; prefer GRAPHRAG_MAX_ESTIMATED_COST_USD.
GRAPHRAG_MAX_ESTIMATED_COST=0
VECTOR_STORE_PROVIDER=lancedb
VECTOR_STORE_ROOT=./media/knowledge_indexes
VECTOR_SEARCH_TOP_K=20
VECTOR_RESULT_TOP_K=6
TEACHING_AGENT_KNOWLEDGE_PROVIDER=demo

# --------------------------
# 老师素材存储路径（F1）
# --------------------------
# ASSET_STORAGE_PATH=./teacher_assets
# MAX_VIDEO_ASSET_SIZE_MB=200
# MAX_AUDIO_ASSET_SIZE_MB=50


# ============================================================
# 第六部分：第三方API配置
# ============================================================

# --------------------------
# 科大讯飞PPT生成API（F3 - AI生成PPT课件）
# --------------------------
XFYUN_PPT_APP_ID=your-xfyun-app-id
XFYUN_PPT_API_SECRET=your-xfyun-api-secret
# 默认模板ID（可选，留空则自动选择免费模板）
# XFYUN_PPT_DEFAULT_TEMPLATE_ID=


# ============================================================
# 第七部分：高级配置（一般无需修改）
# ============================================================

# --------------------------
# G3: Judge0 代码沙箱
# --------------------------
# 启用代码沙箱（需先启动 deploy/judge0/docker-compose.yml）
# Local VirtualBox demo: NAT-forward Ubuntu Judge0 guest port 2358 to the
# Windows host, then use the loopback-only address below. Do not expose this
# port to a LAN or the public Internet.
# JUDGE0_ENABLED=false
# JUDGE0_API_URL=http://127.0.0.1:2358
# JUDGE0_AUTHN_HEADER=X-Auth-Token
# JUDGE0_AUTHN_TOKEN=your-judge0-auth-token
# JUDGE0_AUTHZ_HEADER=X-Auth-User
# JUDGE0_AUTHZ_TOKEN=your-judge0-authz-token
# Secure default is false. Only enable after reviewing Judge0 worker isolation.
# Pin a verified Judge0 image tag/digest before any stable deployment; `latest`
# is acceptable only for a local disposable demo.
# JUDGE0_WORKER_PRIVILEGED=false
# Formal R2 student-answer use still requires each course's Evidence capability.
# R2_STUDENT_ANSWER_ENABLED=false

# 安全白名单路径（无需JWT认证的接口）
# NO_AUTH_WHITELIST=["/api/v1/platform/syncCourse", "/api/v1/platform/syncUser", "/api/v1/user/login", "/api/v1/user/register"]

# 媒体资源白名单路径（跳过签名验证但仍需JWT认证的静态资源）
# MEDIA_RESOURCE_PATHS=["/api/v1/document/course/", "/api/v1/document/audio/"]


# ===========================================
# 配置完成检查清单
# ===========================================
#
# ✅ 必须配置：
#    [ ] STATIC_KEY - 签名密钥
#    [ ] JWT_SECRET_KEY - JWT密钥
#    [ ] DOUBAO_API_KEY 或 QWEN_API_KEY - 至少一个LLM
#    [ ] VOLCENGINE_TTS_* 或 ALIYUN_TTS_* 或 TENCENT_TTS_* - 至少一个TTS
#
# ✅ 推荐配置：
#    [ ] XFYUN_PPT_APP_ID + XFYUN_PPT_API_SECRET - PPT生成功能
#    [ ] DIGITAL_HUMAN_API_URL - 数字人视频生成（默认localhost即可）
#
# ✅ 可选配置：
#    [ ] VOLCENGINE_VOICE_CLONE_* - 声音复刻高级功能
#    [ ] 自定义存储路径 - 根据需要调整
#
# ===========================================
