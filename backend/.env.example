# ===========================================
# 超星AI互动智课系统 - 环境变量配置示例
# ===========================================
#
# 📖 使用方法：
#    1. 复制此文件：cp .env.example .env
#    2. 编辑 .env 文件，填入实际配置值
#    3. 确保敏感信息不提交到版本控制（.gitignore已忽略.env）
#
# ⚠️  安全提示：
#    - 不要将包含真实密钥的 .env 文件提交到Git
#    - 生产环境请使用强密码和随机生成的密钥
#    - 定期轮换API密钥和JWT密钥
#
# 🔗 功能模块对应关系：
#    F1: 素材管理        F2/F5: 映射引擎      F3: PPT生成
#    F4: 脚本编辑/TTS    F6: 分屏播放器       F7: 平台对接
#
# ===========================================

# ============================================================
# 第一部分：核心安全配置（必须修改！）
# ============================================================

# --------------------------
# 签名校验配置（泛雅平台对接 - F7）
# --------------------------
STATIC_KEY=your-static-key-here
SIGN_TIMEOUT_MINUTES=5
SIGN_ALGORITHM=MD5
TIME_FORMAT=%Y-%m-%d %H:%M:%S

# --------------------------
# JWT身份认证配置
# --------------------------
# ⚠️ 生产环境必须使用长随机字符串（至少32位）
JWT_SECRET_KEY=your-jwt-secret-key-very-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120


# ============================================================
# 第二部分：大模型API配置（LLM - 脚本生成核心）
# ============================================================

# --------------------------
# LLM提供商选择
# --------------------------
# 可选值：doubao（豆包/火山引擎）、qwen（通义千问/阿里云）、wenxin（文心一言/百度）、openai
LLM_PROVIDER=doubao

# --------------------------
# 通用LLM参数
# --------------------------
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=180

# OpenAI兼容接口配置（可选，用于自定义OpenAI兼容服务）
# LLM_API_KEY=your-openai-api-key
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-3.5-turbo

# --------------------------
# 豆包配置（火山引擎）【推荐】
# --------------------------
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_ENDPOINT_ID=your-doubao-endpoint-id

# --------------------------
# 通义千问配置（阿里云）
# --------------------------
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL_NAME=qwen-turbo

# --------------------------
# 文心一言配置（百度）
# --------------------------
WENXIN_API_KEY=your-wenxin-api-key
WENXIN_SECRET_KEY=your-wenxin-secret-key


# ============================================================
# 第三部分：语音合成TTS配置（F4 - 数字人配音）
# ============================================================

# --------------------------
# TTS提供商选择
# --------------------------
# 可选值：aliyun（阿里云）、tencent（腾讯云）、volcengine（火山引擎）
TTS_PROVIDER=volcengine

# --------------------------
# 通用TTS参数
# --------------------------
TTS_SAMPLE_RATE=16000
TTS_FORMAT=mp3
# TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts

# 通用TTS凭证（可选，部分提供商使用）
# TTS_API_KEY=your-tts-api-key
# TTS_API_SECRET=your-tts-api-secret
# TTS_APP_ID=your-tts-app-id

# --------------------------
# 阿里云TTS配置
# --------------------------
# ALIYUN_TTS_ACCESS_KEY_ID=your-aliyun-access-key-id
# ALIYUN_TTS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
# ALIYUN_TTS_APP_KEY=your-aliyun-tts-app-key

# --------------------------
# 腾讯云TTS配置
# --------------------------
# TENCENT_TTS_SECRET_ID=your-tencent-secret-id
# TENCENT_TTS_SECRET_KEY=your-tencent-secret-key
# TENCENT_TTS_APP_ID=your-tencent-app-id

# --------------------------
# 火山引擎TTS配置【推荐】
# --------------------------
VOLCENGINE_TTS_APP_ID=your-volcengine-tts-app-id
VOLCENGINE_TTS_ACCESS_TOKEN=your-volcengine-tts-access-token
VOLCENGINE_TTS_SECRET_KEY=your-volcengine-tts-secret-key
# 可选音色：
#   zh_female_shuangkuaisisi_moon_bigtts （女声，推荐）
#   zh_male_chunhou_zhiboshuangkuai         （男声）
TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts

# --------------------------
# 火山引擎声音复刻配置（可选，高级功能）
# --------------------------
# 用于克隆特定声音进行TTS合成
# VOLCENGINE_VOICE_CLONE_API_KEY=your-x-api-key
# 模型类型：1=ICL1.0, 2=DiT标准, 3=DiT还原, 4=ICL2.0(默认)
# VOLCENGINE_VOICE_CLONE_MODEL_TYPE=4


# ============================================================
# 第四部分：数字人视频生成配置（F5 - Gradio API）
# ============================================================

# --------------------------
# 数字人Gradio服务地址
# --------------------------
# 默认本地运行，如使用远程服务请修改为实际地址
DIGITAL_HUMAN_API_URL=http://localhost:7860/

# --------------------------
# 数字人生成参数
# --------------------------
# 分辨率缩小倍数（2=原比例缩小2倍，数值越大分辨率越低但速度越快）
DIGITAL_HUMAN_MIN_RESOLUTION=2
# 是否强制缩小分辨率（true/false）
DIGITAL_HUMAN_IF_RES=False
# 处理批次（越大越快但可能显存不足，建议4-8）
DIGITAL_HUMAN_STEPS=4


# ============================================================
# 第五部分：存储路径配置
# ============================================================

# --------------------------
# 视频文件存储路径（F5/F6）
# --------------------------
# VIDEO_STORAGE_PATH=./videos
# TEMP_VIDEO_STORAGE_PATH=./temp_videos
# MEDIA_STORAGE_PATH=./media

# --------------------------
# 老师素材存储路径（F1）
# --------------------------
# ASSET_STORAGE_PATH=./teacher_assets
# MAX_VIDEO_ASSET_SIZE_MB=200
# MAX_AUDIO_ASSET_SIZE_MB=50


# ============================================================
# 第六部分：第三方API配置
# ============================================================

# --------------------------
# 科大讯飞PPT生成API（F3 - AI生成PPT课件）
# --------------------------
XFYUN_PPT_APP_ID=your-xfyun-app-id
XFYUN_PPT_API_SECRET=your-xfyun-api-secret
# 默认模板ID（可选，留空则自动选择免费模板）
# XFYUN_PPT_DEFAULT_TEMPLATE_ID=


# ============================================================
# 第七部分：高级配置（一般无需修改）
# ============================================================

# --------------------------
# G3: Judge0 代码沙箱
# --------------------------
# 启用代码沙箱（需先启动 deploy/judge0/docker-compose.yml）
# JUDGE0_ENABLED=false
# JUDGE0_API_URL=http://127.0.0.1:2358
# JUDGE0_AUTHN_HEADER=X-Auth-Token
# JUDGE0_AUTHN_TOKEN=your-judge0-auth-token
# JUDGE0_AUTHZ_HEADER=X-Auth-User
# JUDGE0_AUTHZ_TOKEN=your-judge0-authz-token
# Secure default is false. Only enable after reviewing Judge0 worker isolation.
# JUDGE0_WORKER_PRIVILEGED=false
# Formal R2 student-answer use still requires each course's Evidence capability.
# R2_STUDENT_ANSWER_ENABLED=false

# 安全白名单路径（无需JWT认证的接口）
# NO_AUTH_WHITELIST=["/api/v1/platform/syncCourse", "/api/v1/platform/syncUser", "/api/v1/user/login", "/api/v1/user/register"]

# 媒体资源白名单路径（跳过签名验证但仍需JWT认证的静态资源）
# MEDIA_RESOURCE_PATHS=["/api/v1/document/course/", "/api/v1/document/audio/"]


# ===========================================
# 配置完成检查清单
# ===========================================
#
# ✅ 必须配置：
#    [ ] STATIC_KEY - 签名密钥
#    [ ] JWT_SECRET_KEY - JWT密钥
#    [ ] DOUBAO_API_KEY 或 QWEN_API_KEY 或 WENXIN_API_KEY - 至少一个LLM
#    [ ] VOLCENGINE_TTS_* 或 ALIYUN_TTS_* 或 TENCENT_TTS_* - 至少一个TTS
#
# ✅ 推荐配置：
#    [ ] XFYUN_PPT_APP_ID + XFYUN_PPT_API_SECRET - PPT生成功能
#    [ ] DIGITAL_HUMAN_API_URL - 数字人视频生成（默认localhost即可）
#
# ✅ 可选配置：
#    [ ] VOLCENGINE_VOICE_CLONE_* - 声音复刻高级功能
#    [ ] 自定义存储路径 - 根据需要调整
#
# ===========================================
