# ===========================================
# 超星AI互动智课系统 - 环境变量配置示例
# 使用方法：复制此文件为 .env 并填入实际值
# ===========================================

# --------------------------
# 签名校验配置（泛雅平台对接）
# --------------------------
STATIC_KEY=your-static-key-here
SIGN_TIMEOUT_MINUTES=5
SIGN_ALGORITHM=MD5
TIME_FORMAT=%Y-%m-%d %H:%M:%S

# --------------------------
# JWT身份认证配置
# --------------------------
JWT_SECRET_KEY=your-jwt-secret-key-very-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --------------------------
# 大模型API配置
# --------------------------
# 选择的大模型提供商：doubao（豆包）、qwen（通义千问）、wenxin（文心一言）、openai
LLM_PROVIDER=doubao
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=180

# 通用LLM配置（OpenAI兼容接口使用）
# LLM_API_KEY=your-llm-api-key
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-3.5-turbo

# 豆包配置（火山引擎）
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_ENDPOINT_ID=your-doubao-endpoint-id

# 通义千问配置（阿里云）
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL_NAME=qwen-turbo

# 文心一言配置（百度）
WENXIN_API_KEY=your-wenxin-api-key
WENXIN_SECRET_KEY=your-wenxin-secret-key

# --------------------------
# 语音合成API配置
# --------------------------
# 选择的TTS提供商：aliyun（阿里云）、tencent（腾讯云）、volcengine（火山引擎）
TTS_PROVIDER=volcengine
TTS_SAMPLE_RATE=16000
TTS_FORMAT=mp3

# 通用TTS配置（可选，部分提供商使用）
# TTS_API_KEY=your-tts-api-key
# TTS_API_SECRET=your-tts-api-secret
# TTS_APP_ID=your-tts-app-id
# TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts

# 阿里云TTS配置
# ALIYUN_TTS_ACCESS_KEY_ID=your-aliyun-access-key-id
# ALIYUN_TTS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
# ALIYUN_TTS_APP_KEY=your-aliyun-tts-app-key

# 腾讯云TTS配置
# TENCENT_TTS_SECRET_ID=your-tencent-secret-id
# TENCENT_TTS_SECRET_KEY=your-tencent-secret-key
# TENCENT_TTS_APP_ID=your-tencent-app-id

# 火山引擎TTS配置（推荐）
VOLCENGINE_TTS_APP_ID=your-volcengine-tts-app-id
VOLCENGINE_TTS_ACCESS_TOKEN=your-volcengine-tts-access-token
VOLCENGINE_TTS_SECRET_KEY=your-volcengine-tts-secret-key
# 可选音色：zh_female_shuangkuaisisi_moon_bigtts（女声）、zh_male_chunhou_zhiboshuangkuai（男声）
TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts

# --------------------------
# 视频文件存储路径配置
# --------------------------
# VIDEO_STORAGE_PATH=./videos
# TEMP_VIDEO_STORAGE_PATH=./temp_videos

# --------------------------
# 老师素材存储路径配置
# --------------------------
# ASSET_STORAGE_PATH=./teacher_assets
# MAX_VIDEO_ASSET_SIZE_MB=500
# MAX_AUDIO_ASSET_SIZE_MB=50
