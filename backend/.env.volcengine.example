# ===========================================
# 超星AI互动智课系统 - 火山引擎配置示例
# 使用方法：复制此文件内容到 backend/.env
# ===========================================

# --------------------------
# 签名校验配置（泛雅平台对接）
# --------------------------
STATIC_KEY=your-static-key-here
SIGN_TIMEOUT_MINUTES=5
SIGN_ALGORITHM=MD5

# --------------------------
# JWT身份认证配置
# --------------------------
JWT_SECRET_KEY=your-jwt-secret-key-very-long-random-string-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --------------------------
# 大模型API配置
# --------------------------
# 选择的大模型提供商：doubao（豆包）、qwen（通义千问）、wenxin（文心一言）、openai
LLM_PROVIDER=doubao
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# 豆包配置（火山引擎）
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_ENDPOINT_ID=your-doubao-endpoint-id

# --------------------------
# 语音合成API配置（火山引擎）
# --------------------------
# 选择的TTS提供商：volcengine（火山引擎）
TTS_PROVIDER=volcengine
TTS_SAMPLE_RATE=16000
TTS_FORMAT=mp3

# 火山引擎TTS配置
# 请填写你的火山引擎TTS配置信息
VOLCENGINE_TTS_APP_ID=你的APP_ID
VOLCENGINE_TTS_ACCESS_TOKEN=你的Access_Token
VOLCENGINE_TTS_SECRET_KEY=你的Secret_Key

# 音色选择（可选）
# 女声：zh_female_shuangkuaisisi_moon_bigtts（推荐）
# 男声：zh_male_chunhou_zhiboshuangkuai
TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts
