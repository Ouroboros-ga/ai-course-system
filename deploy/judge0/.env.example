# Copy to .env and replace every value before starting Judge0.
# Never commit the real .env file.
JUDGE0_AUTHN_TOKEN=replace-with-a-long-random-authn-token
JUDGE0_AUTHZ_TOKEN=replace-with-a-long-random-authz-token
JUDGE0_REDIS_PASSWORD=replace-with-a-long-random-redis-password
JUDGE0_POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# Judge0 isolate requires privileged server *and* worker containers. Keep
# both false for configuration validation. Set both true only on a dedicated,
# hardened Judge0 host after the deployment security review.
JUDGE0_SERVER_PRIVILEGED=false
JUDGE0_WORKER_PRIVILEGED=false
