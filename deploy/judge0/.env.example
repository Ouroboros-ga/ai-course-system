# Copy to .env and replace every value before starting Judge0.
# Never commit the real .env file.
JUDGE0_AUTHN_TOKEN=replace-with-a-long-random-authn-token
JUDGE0_AUTHZ_TOKEN=replace-with-a-long-random-authz-token
JUDGE0_REDIS_PASSWORD=replace-with-a-long-random-redis-password
JUDGE0_POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# P0-2: privileged mode has been removed from docker-compose.yml to prevent
# sandbox escape (privileged overrides no-new-privileges). Judge0 isolate now
# runs with the minimal cap_add: SYS_ADMIN. If isolate cannot run on your host,
# you must manually edit docker-compose.yml on a dedicated, hardened Judge0
# host after a deployment security review — do not re-enable privileged via
# environment variables.
