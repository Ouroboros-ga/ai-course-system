# Copy this file outside Git, for example /opt/smartcarb-postgres/postgres.env,
# set mode 600, and pass it to docker compose with --env-file.
POSTGRES_IMAGE=postgres:16.14-alpine3.23
POSTGRES_CONTAINER_NAME=smartcarb-postgres
POSTGRES_DB=ai_course
POSTGRES_SUPERUSER=ai_course_bootstrap
POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
AI_COURSE_APP_DB_USER=ai_course_app
AI_COURSE_APP_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
AI_COURSE_MIGRATION_DB_USER=ai_course_migration
AI_COURSE_MIGRATION_DB_PASSWORD=REPLACE_WITH_A_THIRD_LONG_RANDOM_SECRET
POSTGRES_DATA_DIR=/var/lib/smartcarb-postgres/16/data
POSTGRES_BACKUP_DIR=/opt/smartcarb-backups/postgres
