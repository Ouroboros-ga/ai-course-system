# 任务镜像（T1-b）：python:3.12-slim＋预装 swe-rex==1.4.0。
# 运行时不再 pip 安装（启动秒级、离线确定、无 PyPI 抖动面）。
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
RUN pip install --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    "swe-rex==1.4.0" "aiohttp>=3.10" \
 && swerex-remote --version
WORKDIR /workspace
