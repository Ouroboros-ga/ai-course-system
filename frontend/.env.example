# Internal design prototypes are excluded from routing unless explicitly enabled.
VITE_ENABLE_FRONTEND_PROTOTYPES=false

# Rollback switch for the formal student learning workspace.
# false: keep the existing StudentPlayer page
# true: use StudentLearningWorkspace for /player/course/:courseId
VITE_ENABLE_STUDENT_LEARNING_WORKSPACE=false

# Rollout switches for the teacher course-production and knowledge-mapping
# workspaces. Both default to the established teacher Dashboard.
VITE_ENABLE_TEACHER_PRODUCTION_WORKSPACE=false
VITE_ENABLE_KNOWLEDGE_MAPPING_WORKSPACE=false

# Same-origin JSAV asset directory. It must contain the exact reviewed files:
# jquery-3.7.1.min.js, raphael-2.3.0.min.js, JSAV-0.4.1.js, JSAV-0.4.1.css.
# Public CDN URLs are intentionally rejected by the authenticated player.
VITE_JSAV_ASSET_BASE=/vendor/jsav

# ---------------------------------------------------------------------------
# 本地开发连云端后端（可选，仅本地生效）
# vite dev server 会把 /api 代理到该目标，从而在本地访问云服务器 API 和数据。
# 使用方法：复制本文件为 frontend/.env.development.local 并去掉下面这行的注释，
# 然后重启本地 dev server（端口 5300）。不要提交 .env.development.local。
# 云服务器公网入口是 nginx 80 端口（后端本身只绑定 127.0.0.1:8000，不对外）。
# VITE_API_PROXY_TARGET=http://120.26.104.247
#
# 请求签名密钥 STATIC_KEY：dev 默认值，非敏感，已同时硬编码在 src/utils/request.js。
# STATIC_KEY=dev-static-key-change-in-prod
# ---------------------------------------------------------------------------
