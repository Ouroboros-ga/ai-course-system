# Internal design prototypes are excluded from routing unless explicitly enabled.
VITE_ENABLE_FRONTEND_PROTOTYPES=false

# Rollback switch for the formal student learning workspace.
# false: keep the existing StudentPlayer page
# true: use StudentLearningWorkspace for /player/course/:courseId
VITE_ENABLE_STUDENT_LEARNING_WORKSPACE=false

# Rollout switches for the teacher course-production and knowledge-mapping
# workspaces. Both default to the established teacher Dashboard.
VITE_ENABLE_TEACHER_PRODUCTION_WORKSPACE=false
VITE_ENABLE_KNOWLEDGE_MAPPING_WORKSPACE=false
