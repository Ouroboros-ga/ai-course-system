# Nexus Runtime 环境变量模板（复制为 .env 后填真实值）
# 全部变量带 NEXUS_ 前缀（config.py env_prefix="NEXUS_"，M0-B2 对齐）。
# LLM：DeepSeek（OpenAI 兼容）。Key 不进仓库、不进日志。
NEXUS_DEEPSEEK_API_KEY=
# 主 LLM 模型名。官方可选值：[deepseek-flash, deepseek-v4-pro]。
# 旧 ID deepseek-chat / deepseek-reasoner 已于北京时间 2026-07-24 23:59 弃用。
NEXUS_LLM_MODEL=deepseek-flash
# 单次生成上限（token），官方范围 1~384K。<=0 表示不发送（回落服务端默认：
# 非思考 8K / 思考 64K）。显式设置以避免依赖随版本漂移的隐式默认。
NEXUS_LLM_MAX_TOKENS=65536
# 思考模式开关：enabled / disabled。此处为**服务端默认值**；前端思考开关可按
# 单次请求覆盖（请求体 thinking 字段 → 进入 agent 实例缓存键维度）。
# 可安全开启：官方要求携带 tools 的请求必须在后续所有轮次完整回传
# reasoning_content，否则 400；langchain_openai.ChatOpenAI 不保留该字段，
# 已改用 langchain-deepseek.ChatDeepSeek 并由 agent._NexusChatDeepSeek
# 补齐发送侧回传（2026-09-11）。另注：思考模式下 temperature 不生效。
NEXUS_LLM_THINKING=enabled
# 思考强度（仅 NEXUS_LLM_THINKING=enabled 时发送）：low / high / max
NEXUS_LLM_REASONING_EFFORT=high

# Web Search 主通道：SearXNG（部署于 103.36.223.177，服务器侧 127.0.0.1:8888）
# 本地开发可通过 SSH 隧道：ssh -L 8888:127.0.0.1:8888 root@103.36.223.177
# 留空则主通道禁用，直接走本机 DuckDuckGo 降级。
NEXUS_SEARXNG_URL=http://127.0.0.1:8888

# 本机 Web Search 降级通道（duckduckgo-search 库，由本机 IP 发起）
NEXUS_DDGS_ENABLED=true

# Quick Reproduction Worker（未配置时复现工具返回 REPRO_WORKER_UNAVAILABLE，不假造执行）
NEXUS_REPRO_WORKER_URL=
# Worker Bearer 令牌（对应 Worker 侧 REPRO_WORKER_TOKEN；双方都配置才启用认证）
NEXUS_REPRO_WORKER_TOKEN=

# 自主实验执行控制面（repro-runtime，默认 127.0.0.1:8401；T1-b/T4）。
# 留空=未配置：自主实验 run 落 failed（SANDBOX_NOT_CONFIGURED），不静默 running。
NEXUS_REPRO_CONTROL_URL=
NEXUS_REPRO_CONTROL_TOKEN=

# T5：run 归属登记/产物内部端点（Backend 内网地址与内部令牌）。
# 留空=linkage 走 not_found 兼容分支，不影响聊天主链。
NEXUS_BACKEND_INTERNAL_URL=
NEXUS_BACKEND_INTERNAL_TOKEN=

# 多模型网关（逗号分隔的模型名；留空=仅使用 NEXUS_LLM_MODEL）
NEXUS_LLM_MODELS=

# NX-G2 执行审批：提案有效期（秒）。过期票据一律失效，需重新提案
NEXUS_APPROVAL_TTL_S=900
# NX-G3 依赖健康探针 TTL（秒）。/health 的 checks 为带检查时间+有效期的快照
NEXUS_HEALTH_PROBE_TTL_S=60

# Runtime 服务鉴权（配置后所有 /api/v1/nexus/* 要求 Authorization: Bearer <key>；
# 由 Backend 反代以内部服务令牌身份调用，用户 JWT 不外泄。留空=开放，仅限本地）
NEXUS_API_KEY=

# P1-C 会话持久化：留空=本地 InMemory（无需本地 PG）；服务器填真实 PG DSN。
# 示例：NEXUS_POSTGRES_DSN=postgresql://ai_course_app:***@127.0.0.1:5432/ai_course
# 表落在独立 schema nexus_checkpoints，不混入业务表。
NEXUS_POSTGRES_DSN=
NEXUS_POSTGRES_SCHEMA=nexus_checkpoints
NEXUS_RETENTION_DAYS=30
# Compact 阈值（默认对应 V4 的 1M 上下文约 20% 处触发，保留近期 20 条）
NEXUS_SUMMARY_TRIGGER_TOKENS=200000
NEXUS_SUMMARY_KEEP_MESSAGES=20

# 服务监听
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8300
