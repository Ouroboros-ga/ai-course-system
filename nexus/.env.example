# Nexus Runtime 环境变量模板（复制为 .env 后填真实值）
# LLM：DeepSeek（OpenAI 兼容）。Key 不进仓库、不进日志。
DEEPSEEK_API_KEY=
# 主 LLM 模型名（deepseek-chat / deepseek-reasoner）
NEXUS_LLM_MODEL=deepseek-chat

# Web Search 主通道：SearXNG（部署于 47.99.97.154，服务器侧 127.0.0.1:8888）
# 本地开发可通过 SSH 隧道：ssh -L 8888:127.0.0.1:8888 root@47.99.97.154
# 留空则主通道禁用，直接走本机 DuckDuckGo 降级。
NEXUS_SEARXNG_URL=http://127.0.0.1:8888

# 本机 Web Search 降级通道（duckduckgo-search 库，由本机 IP 发起）
NEXUS_DDGS_ENABLED=true

# Quick Reproduction Worker（未配置时复现工具返回 REPRO_WORKER_UNAVAILABLE，不假造执行）
NEXUS_REPRO_WORKER_URL=

# P1-C 会话持久化：留空=本地 InMemory（无需本地 PG）；服务器填真实 PG DSN。
# 示例：NEXUS_POSTGRES_DSN=postgresql://ai_course_app:***@127.0.0.1:5432/ai_course
# 表落在独立 schema nexus_checkpoints，不混入业务表。
NEXUS_POSTGRES_DSN=
NEXUS_POSTGRES_SCHEMA=nexus_checkpoints
NEXUS_RETENTION_DAYS=30
# Compact 阈值（默认 deepseek-chat 64k 窗口约 78% 触发，保留近期 20 条）
NEXUS_SUMMARY_TRIGGER_TOKENS=50000
NEXUS_SUMMARY_KEEP_MESSAGES=20

# 服务监听
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8300
